# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# Data & model artifacts (never commit raw audio/checkpoints to git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Manifest hiệu đính thủ công (clean-test) là công sức tay, PHẢI track dù
# nằm trong data/processed/ — chỉ audio/transcript thô mới loại trừ.
!data/processed/clean_test_manifest.json
!data/processed/clean_test_word_tags.tsv
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.wav
*.flac

# Audio/dữ liệu đuôi khác (rule trên chỉ chặn .wav/.flac)
*.mp3
*.m4a
*.ogg
*.opus
*.mp4
*.webm
*.parquet
*.arrow
*.npy
*.npz
*.safetensors
*.onnx

# Cache ở bất kỳ cấp nào — chạy notebook từ notebooks/ đã từng đẻ ra
# notebooks/data/raw/..., không khớp rule gốc `data/raw/*` ở trên.
**/audio_cache/
**/eda_audio_cache/
**/.cache/

# Bí mật / thông tin đăng nhập
.env
.env.*
kaggle.json
hf_token*

# Tài liệu nhị phân: lưu trên Google Drive, không đưa lên GitHub (repo public,
# có họ tên/MSSV và biểu mẫu nội bộ của khoa). Chỉ giữ ghi chú .md trong
# docs/notes/ trên git.
docs/de_cuong/
docs/bieu_mau/
docs/khoa_luan/
*.docx
*.doc
docs/notes/TLCN_*
~$*

# Logs
*.log
runs/
wandb/
outputs/
lightning_logs/
events.out.tfevents.*

# Notebook nháp/output chạy thử — Plan.md quy định không commit
notebooks/temp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code session state
.claude/

# Cấu hình kernel Kaggle chứa username tài khoản — giữ local (repo public)
scripts/kaggle/**/kernel-metadata.json
docs/tong_ket/

# Bản sinh của launcher train full (chứa username)
scripts/kaggle/train_full/_build/
scripts/kaggle/finetune_parakeet/_build/

# Output train full tải về (scripts/kaggle/train_full/fetch.py): giữ metrics/log/summary, bỏ phần lớn
reports/results/train_full/**/eval_*.jsonl
reports/results/train_full/**/runs/
# Bản sinh từ scripts/kaggle/zero_shot/zero_shot.py lúc đẩy kernel bảng so sánh cuối
scripts/kaggle/final_compare/final_compare.py

# Audio/ảnh thử demo ngoài bộ dữ liệu (người dùng 17/10: không đưa lên repo public; ảnh demo lưu Drive)
data/Test_micro/
scripts/kaggle/*/_build/
# Giả thuyết trên test/dev GigaSpeech 2 (gần như bản phiên âm dữ liệu gated) — chỉ giữ local; summary/kết quả chấm thì commit
reports/results/gs2_eval_*/**/greedy.json
reports/results/gs2_eval_*/**/*hyps*.tsv
# Chat riêng với GVHD (họ tên người thứ ba) — chỉ giữ local
docs/notes/Thao_Luan_*.txt
# Ánh xạ tài khoản Kaggle → thư mục khoá (tên người thứ ba) — chỉ local
scripts/kaggle/accounts.local.json
